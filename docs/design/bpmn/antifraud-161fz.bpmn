    <bpmndi:BPMNPlane id="plane_161fz" bpmnElement="collab_161fz">
      <bpmndi:BPMNShape id="pool_bank_di" bpmnElement="pool_bank" isHorizontal="true"><dc:Bounds x="0" y="0" width="2620" height="740" /></bpmndi:BPMNShape>
