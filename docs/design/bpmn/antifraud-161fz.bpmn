<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_161fz" targetNamespace="https://github.com/KORTEZZ12/phone-transfers" exporter="phone-transfers" exporterVersion="0.3">
  <bpmn:collaboration id="collab_161fz">
    <bpmn:participant id="pool_bank" name="Перевод с признаками мошенничества, 161-ФЗ" processRef="proc_161fz" />
  </bpmn:collaboration>
  <bpmn:process id="proc_161fz" isExecutable="false">
    <bpmn:laneSet id="laneset_161fz">
      <bpmn:lane id="lane_client" name="Отправитель">
        <bpmn:flowNodeRef>t_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bt_p20</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_service" name="Сервис переводов">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rej_af</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej_af</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_suspend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rej_nc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej_nc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_af" name="Антифрод">
        <bpmn:flowNodeRef>t_af</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cbr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sb" name="Сотрудник СБ">
        <bpmn:flowNodeRef>t_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bt_48</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Сумма заблокирована">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t_check" name="Запросить проверку перевода">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_af" name="Проверить признаки и базу ЦБ">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_need" name="Нужна ручная проверка?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_manual" name="Проверить перевод вручную">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_dec" name="Решение">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_rej_af" name="Отклонить, снять холд">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_rej_af" name="Отклонён">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_suspend" name="Приостановить, пуш с запросом">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_confirm" name="Подтвердить или отменить перевод">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_conf" name="Подтвердил?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_rej_nc" name="Отклонить: не подтверждён">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_rej_nc" name="Отклонён">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_cancel" name="Отменить, снять холд">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_cancel" name="Отменён">
      <bpmn:incoming>f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_recheck" name="Повторно сверить с базой ЦБ">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_cbr" name="Есть новые сведения?">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="tm_wait" name="2 дня от приостановки, P-21">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_wait" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_join" name="">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_post" name="Провести перевод">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Выполнен">
      <bpmn:incoming>f24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="bt_48" name="48 ч от первого REVIEW, P-11" attachedToRef="t_manual">
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_bt_48" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="bt_p20" name="Срок P-20" attachedToRef="t_confirm">
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_bt_p20" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_check" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_check" targetRef="t_af" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_af" targetRef="g_need" />
    <bpmn:sequenceFlow id="f4" sourceRef="g_need" targetRef="g_dec" name="Нет" />
    <bpmn:sequenceFlow id="f5" sourceRef="g_need" targetRef="t_manual" name="Да" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_manual" targetRef="g_dec" />
    <bpmn:sequenceFlow id="f7" sourceRef="bt_48" targetRef="t_rej_af" />
    <bpmn:sequenceFlow id="f8" sourceRef="g_dec" targetRef="t_rej_af" name="Отклонить" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_rej_af" targetRef="end_rej_af" />
    <bpmn:sequenceFlow id="f10" sourceRef="g_dec" targetRef="t_suspend" name="Признаки 161-ФЗ" />
    <bpmn:sequenceFlow id="f11" sourceRef="g_dec" targetRef="t_post" name="Разрешить" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_suspend" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_confirm" targetRef="g_conf" />
    <bpmn:sequenceFlow id="f14" sourceRef="bt_p20" targetRef="t_rej_nc" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_rej_nc" targetRef="end_rej_nc" />
    <bpmn:sequenceFlow id="f16" sourceRef="g_conf" targetRef="t_cancel" name="Отменил" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_cancel" targetRef="end_cancel" />
    <bpmn:sequenceFlow id="f18" sourceRef="g_conf" targetRef="t_recheck" name="Подтвердил" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_recheck" targetRef="g_cbr" />
    <bpmn:sequenceFlow id="f20" sourceRef="g_cbr" targetRef="g_join" name="Нет" />
    <bpmn:sequenceFlow id="f21" sourceRef="g_cbr" targetRef="tm_wait" name="Да" />
    <bpmn:sequenceFlow id="f22" sourceRef="tm_wait" targetRef="g_join" />
    <bpmn:sequenceFlow id="f23" sourceRef="g_join" targetRef="t_post" />
    <bpmn:sequenceFlow id="f24" sourceRef="t_post" targetRef="end_ok" />
  </bpmn:process>
